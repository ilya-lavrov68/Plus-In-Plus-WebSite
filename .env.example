# ---------------------------------------------------------------------------
# Database — Turso / libSQL (the same variable in development and production)
# ---------------------------------------------------------------------------
# Production (Turso Cloud):  https://docs.turso.tech/quickstart
#   turso db create plus-in-plus
#   turso db show plus-in-plus --url        → libsql://plus-in-plus-<org>.turso.io
#   turso db tokens create plus-in-plus     → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Local development without any account: a plain SQLite file.
# Leave TURSO_DATABASE_URL empty (the app then uses prisma/dev.db) or set:
# TURSO_DATABASE_URL="file:./prisma/dev.db"
#
# A self-hosted libSQL/sqld server also works: TURSO_DATABASE_URL="http://127.0.0.1:8080"

# Apply the schema after every change (there are no migration files):
#   npm run db:push     npm run db:check

# ---------------------------------------------------------------------------
# Auth.js v5 — use a UNIQUE secret of at least 32 characters.
# Generate it with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# Auth.js infers the host from the trusted reverse proxy by default.
# Set the real HTTPS URL in production, NOT localhost when using a preview URL.
# AUTH_URL="https://your-domain.example"
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Legacy NEXTAUTH_SECRET / NEXTAUTH_URL remain supported during migration from v4.

# ---------------------------------------------------------------------------
# Payments — Robokassa (invoices are issued by a manager, never by the client)
# ---------------------------------------------------------------------------
# Without these three variables the site keeps working: the manager still
# agrees the price and the invoice row is still written to the database, it
# simply has no payment link yet. Fill them in to turn links on.
ROBOKASSA_MERCHANT_LOGIN=""
ROBOKASSA_PASSWORD1=""     # signs what we send out (payment form)
ROBOKASSA_PASSWORD2=""     # verifies what comes back (server notification)
# Set to "1" while testing: no real money moves. Clear it for production.
ROBOKASSA_TEST_MODE="1"
# md5 (default) | ripemd160 | sha256 | sha512 — must match the shop settings.
ROBOKASSA_HASH_ALGO="md5"

# Where Robokassa sends the browser after an attempt. Register the same URLs
# in the merchant dashboard, otherwise payments will not be confirmed.
#   Result URL:  https://<domain>/api/payments/robokassa/result
#   Success URL: https://<domain>/payment/success
#   Fail URL:    https://<domain>/payment/fail
