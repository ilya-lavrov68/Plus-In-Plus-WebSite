# ---------------------------------------------------------------------------
# Единая SQLite/libSQL база: сайт, админка, auth, заказы и аналитика
# ---------------------------------------------------------------------------
# Локально достаточно файла; production задаёт Turso/libSQL URL и auth token.
# Схема принадлежит репозиторию (db/schema.sql), CMS-слоя и его миграций нет.
DATABASE_URL="file:./payload/pip.db"
DATABASE_AUTH_TOKEN=""
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN остаются только aliases для существующего
# Turso secret manager. Не настраивайте вторую БД: старой Prisma-БД больше нет.
# После изменения схемы:
#   npm run db:migrate
#   npm run db:check

# ---------------------------------------------------------------------------
# Auth.js v5 — уникальный секрет не короче 32 символов для каждого окружения
# ---------------------------------------------------------------------------
# Генерация: openssl rand -base64 32
# AUTH_SECRET также используется для вывода отдельного ключа шифрования TOTP через HKDF.
# Его ротация завершает сессии и требует повторной настройки TOTP: планируйте заранее.
AUTH_SECRET=""

# В production укажите реальный HTTPS URL, а не localhost или чужой preview URL.
# AUTH_URL="https://your-domain.example"
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Passkeys / WebAuthn. В production обе настройки обязательны для passkey-операций.
# origin включает схему и необязательный порт, RP ID — hostname или его родительский домен.
# Пример: origin https://www.example.com, RP ID example.com.
# HTTP разрешён только для локальной разработки; в production требуется HTTPS.
WEBAUTHN_ORIGIN=""
WEBAUTHN_RP_ID=""

# Длительности access/refresh и лимит сессий не дублируются в env.
# Единый источник значений: lib/session-policy.ts.

# ---------------------------------------------------------------------------
# Проверка скомпрометированных паролей при регистрации и смене пароля
# ---------------------------------------------------------------------------
# HIBP k-anonymity получает только первые пять символов SHA-1, но не пароль,
# email или полный hash. Проверка включена, кроме явного PIP_HIBP_CHECK=0.
PIP_HIBP_CHECK="1"
# Пусто: fail closed в production, fail open в development.
# 0 — осознанное исключение доступности; на существующий вход не влияет.
PIP_HIBP_REQUIRED=""

# ---------------------------------------------------------------------------
# Общие rate limits для нескольких инстансов / serverless production
# ---------------------------------------------------------------------------
# Указывайте обе переменные Upstash Redis REST или обе оставляйте пустыми.
# Без них остаётся ограниченный process-local fallback, не являющийся distributed limit.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Content Security Policy
# ---------------------------------------------------------------------------
# Пусто / enforce — enforcing CSP; report-only — наблюдение без блокировки.
# off работает только в локальной разработке: production всегда сохраняет enforcing CSP.
PIP_CSP=""
# Отчёты принимает POST /api/security/csp-report; логируется только allowlisted directive.

# ---------------------------------------------------------------------------
# Псевдонимизация старых ActivityLog — только для отдельной retention-задачи
# ---------------------------------------------------------------------------
# Не используйте AUTH_SECRET или платёжные ключи. Храните стабильный отдельный секрет
# в secret manager; длина — не менее 32 символов. Сначала всегда выполняйте dry-run.
# AUDIT_PSEUDONYM_KEY="сгенерируйте-отдельный-случайный-секрет"

# ---------------------------------------------------------------------------
# Платежи Robokassa — счёт выставляет менеджер после согласования цены
# ---------------------------------------------------------------------------
# Источники ключей по приоритету: 1) Settings в БД, только FOUNDER;
# 2) переменные ниже; 3) публичный demo-магазин только при разрешённом demo mode.
# Без ключей заявка и строка счёта сохраняются, но платёжная ссылка не создаётся.
# Сейчас реальные платежи через Robokassa в проекте не принимаются. Не включайте
# production-оплату до подтверждения владельцем цен, реквизитов и live-проверки.
ROBOKASSA_MERCHANT_LOGIN=""
ROBOKASSA_PASSWORD1=""     # подпись исходящей платёжной формы
ROBOKASSA_PASSWORD2=""     # проверка серверного уведомления
# 1 — тестовый режим; для боевых операций требуется отдельное согласованное включение.
ROBOKASSA_TEST_MODE="1"
# md5 (по умолчанию) | ripemd160 | sha256 | sha512 — как в настройках магазина.
ROBOKASSA_HASH_ALGO="md5"
# Не включайте публичный TestMerchant в production: его пароль общеизвестен,
# поэтому уведомление о оплате можно подделать. Флаг только для краткого e2e-теста.
ROBOKASSA_DEMO_MODE=""

# Зарегистрируйте одинаковые URL в кабинете Robokassa:
#   Result URL:  https://<domain>/api/payments/robokassa/result
#                алиас: https://<domain>/api/payment/result
#   Success URL: https://<domain>/payment/success
#   Fail URL:    https://<domain>/payment/fail
# Создание платёжной ссылки из браузера: только same-origin POST /api/payment/create.
