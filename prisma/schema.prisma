// Single schema for development and production.
//
// The app talks to a libSQL/SQLite database through the @prisma/adapter-libsql
// driver adapter:
//   - development / offline: a local SQLite file (prisma/dev.db, default)
//   - production:            Turso Cloud (libsql://…) or any libSQL server (http(s)://…)
//
// SQLite is the only provider that speaks the libSQL wire format, so the
// datasource provider must be "sqlite" — a libSQL endpoint is NOT a PostgreSQL
// server. Schema changes are applied with `npm run db:push` (no migration files),
// which is what keeps dev and production byte-for-byte identical.
//
// SQLite has no native enum and no first-class JSON column, therefore:
//   * Role is a String constrained by the application layer ("USER" | "ADMIN")
//   * includes/shapes are JSON-encoded Strings, read/written with lib/db-helpers.ts
generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  // The app connects through a driver adapter, so the client is generated for the
  // WASM query compiler ("client" engine). This keeps the generated output
  // platform-independent (no native engine binary).
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String? // Имя (для отображения после входа и в заявках)
  lastName     String? // Фамилия
  avatar       String? // Путь к файлу аватарки в /public/uploads/avatars/
  role         String        @default("USER") // "USER" | "MANAGER" | "ADMIN" | "FOUNDER"
  isBlocked    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  activities   ActivityLog[]
  orders       Order[]       @relation("CustomerOrders")
  // Заказы, по которым этот пользователь согласовал цену как менеджер.
  managedOrders Order[]      @relation("ManagedOrders")
  // Заказы, которые этот пользователь заблокировал от редактирования.
  lockedOrders  Order[]      @relation("LockedOrders")

  @@map("users")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique // URL segment: /shop/sign-design
  category    String // "small" or "large"
  shortDesc   String
  fullDesc    String
  includes    String // JSON-encoded string array
  shapes      String // JSON-encoded string array
  resultText  String
  coverImage  String
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Продажа и цена ────────────────────────────────────────────────────────
  // Все деньги — целые копейки. Float для денег не используется никогда:
  // 0.1 + 0.2 !== 0.3, и на суммах заказа это даёт расхождения в отчётах.
  basePrice   Int     @default(0) // копейки
  // "fixed" — цена окончательная; "from" — «от N ₽», точная сумма после обсуждения;
  // "quote" — цены на сайте нет, только запрос расчёта
  priceType   String  @default("quote") // "fixed" | "from" | "quote"
  currency    String  @default("RUB")
  isOrderable Boolean @default(false) // разрешить класть в корзину
  isActive    Boolean @default(true) // показывать ли услугу на сайте

  optionGroups ServiceOptionGroup[]
  orderItems   OrderItem[]
  orders       OrderService[]

  @@index([slug])
  @@index([category])
  @@map("services")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  coverImage  String?
  category    String? // "merch", "apparel" и т.д.
  isActive    Boolean  @default(true)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([slug])
  @@index([category])
  @@map("products")
}

/// Группа опций услуги («Размер», «Материал», «Тираж»).
/// Цена считается как round((basePrice + Σ priceDelta) * Π priceFactor).
model ServiceOptionGroup {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name      String
  // Обязательная группа всегда имеет выбранную опцию (первая или isDefault).
  required  Boolean  @default(true)
  sortOrder Int      @default(0)
  options   ServiceOption[]

  @@index([serviceId])
  @@map("service_option_groups")
}

model ServiceOption {
  id          String             @id @default(cuid())
  groupId     String
  group       ServiceOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label       String
  // Копейки, прибавляемые к базовой цене. Может быть отрицательной (скидка).
  priceDelta  Int                @default(0)
  // Множитель цены — для тиражей и размеров («100 шт» = ×2.5).
  priceFactor Float              @default(1)
  isDefault   Boolean            @default(false)
  sortOrder   Int                @default(0)

  @@index([groupId])
  @@map("service_options")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String
  images      String? // JSON массив дополнительных изображений (альбом)
  readTime    Int       @default(5)
  source      String    @default("manual")
  sourceUrl   String? // Ссылка на источник (VK, YouTube, Telegram)
  isFeatured  Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("posts")
}

// Append-only history, including deleted content; never pre-populated.
model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  title      String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

/// Сырые события просмотров — основа панели аналитики.
model PageView {
  id         String   @id @default(cuid())
  path       String
  sessionId  String?
  visitorId  String?
  referrer   String? // источник перехода (домен или полный URL)
  utmSource  String? // ?utm_source=… — для метки рекламных кампаний
  userAgent  String?
  device     String? // "desktop" | "mobile" | "tablet"
  durationMs Int? // сколько провели на странице, миллисекунды
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
  @@index([visitorId, createdAt])
  @@map("page_views")
}

/// Единая модель Order для корзины и оформленных заказов:
///   - status = "cart"     → черновик корзины (orderNumber / number = null)
///   - status = "pending"  → оформленная заявка из корзины или формы /contact
///   - далее: quote_requested / negotiating → priced / awaiting_payment → paid / in_progress / completed / cancelled / refunded
model Order {
  id              String         @id @default(cuid())
  // Человекочитаемый номер (ПИП-000001), генерируется при checkout / оформлении заказа.
  orderNumber     String?        @unique
  number          String?        @unique
  userId          String
  user            User           @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Cascade)
  // Exactly one active cart per user. NULL is released at checkout, so SQLite
  // can keep any number of submitted orders for the same customer.
  cartKey         String?        @unique
  status          String         @default("cart")
  estimatedAmount Int            @default(0)
  subtotal        Int            @default(0)
  discount        Int            @default(0)
  total           Int            @default(0)
  currency        String         @default("RUB")
  deadline        DateTime?
  description     String?
  finalPrice      Float?
  customerNote    String?
  managerNote     String?
  managerId       String?
  manager         User?          @relation("ManagedOrders", fields: [managerId], references: [id], onDelete: SetNull)
  priceAgreedAt   DateTime?
  isLocked        Boolean        @default(false)
  lockedAt        DateTime?
  lockedById      String?
  lockedBy        User?          @relation("LockedOrders", fields: [lockedById], references: [id], onDelete: SetNull)
  services        OrderService[]
  items           OrderItem[]
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paidAt          DateTime?

  @@index([userId, status])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([managerId])
  @@map("orders")
}

model OrderService {
  id        String  @id @default(cuid())
  orderId   String
  serviceId String
  quantity  Int     @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([orderId, serviceId])
  @@index([orderId])
  @@index([serviceId])
  @@map("order_services")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType           String   @default("service") // "service" или "product"
  itemId             String   @default("")        // ID услуги или товара
  serviceId          String?
  service            Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title              String   @default("")
  quantity           Int      @default(1)
  estimatedUnitPrice Int      @default(0)
  unitPrice          Int      @default(0)
  totalPrice         Int      @default(0)
  optionsSnapshot    String   @default("[]")

  @@index([orderId])
  @@index([orderId, itemType, itemId])
  @@map("order_items")
}

/// Попытка оплаты.
model Payment {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  externalId String?
  status     String    @default("pending")
  amount     Int
  currency   String    @default("RUB")
  paymentUrl String?
  rawPayload String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paidAt     DateTime?

  @@index([orderId])
  // Robokassa identifies a payment by provider + InvId. Prevent concurrent
  // invoice attempts from creating ambiguous callback targets.
  @@unique([provider, externalId])
  @@map("payments")
}

/// Настройки сайта «ключ → значение» (доступны только FOUNDER).
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
